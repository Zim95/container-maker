FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1

# Create the directory
RUN mkdir app
COPY . app/
WORKDIR /app

# Make entrypoint script executable
RUN chmod +x ./infra/k8s/deployment/entrypoint-deployment.sh

# Install dependencies
RUN apt-get update && apt-get install -y build-essential curl git

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:${PATH}"

# Install dependencies (in-project venv is fine in prod — no volume mount to clobber it)
RUN poetry install --no-root

# Use the production entrypoint (runs the gRPC server directly)
ENTRYPOINT ["bash", "-c", "./infra/k8s/deployment/entrypoint-deployment.sh"]
